{
  "dataset": {
    "raw_dir": "tabular/data/raw",
    "output_dir": "tabular/data/processed",
    "primary_csv": "dataset_prepro_routine_generated.csv",
    "steps_per_day": 144,
    "seed": 42
  },
  "meta_training_split": {
